{
  // Display name for this crew
  "name": "Report_crew",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["Search_info", "Create_report"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "search_the_official_erasmus_task",

      // What the task should accomplish.
      // Returns BureaucracyThinking (questions) if personal info is missing,
      // or proceeds with research if {extra_inputs} already has what is needed.
      "description": "Research the official Erasmus+ website of {destination_country} and the official portals of {destination_university} and the city of {destination_city}. Your goal is to gather verified information for an incoming Erasmus+ student arriving in {destination_city}, {destination_country} during {semester}.\n\nBefore starting the full research, decide whether you need personal details from this specific student that would change your findings (e.g. their nationality or EU citizenship status, the exact duration of stay, or any other detail that affects legal obligations). Check {extra_inputs} first — if the answer is already there, proceed with the research.\n\nIf an essential personal detail is still missing after checking {extra_inputs}, STOP immediately. Do NOT guess and do NOT start researching. Return a BureaucracyThinking object whose 'questions' list contains at most 3 short, specific questions.\n\nIf you have everything you need, do the full research and gather:\n- PART 1 — Arrival 'must do' steps: only actions officially required or recommended for incoming students (registration with local authorities, residence certificate, tax number, health insurance, housing registration, etc.).\n- PART 2 — Public transport card: operator name, where to apply, required documents, student discount conditions, official link.\n- PART 3 — Other relevant information: accommodation support, health care, student services, orientation programmes, language courses, cultural activities, practical living info — only if present on official sources.\n\nDO NOT include application procedures, eligibility criteria, deadlines, or grants.",

      "expected_output": "If personal information is missing: a BureaucracyThinking object with a 'questions' list (at most 3 items, each with 'text' and 'why'). If nothing is missing: research notes structured as a BureaucracyReport with 'arrival_checklist', 'transport_card_steps', and 'other_info' lists (each ChecklistItem has 'title', 'description', and 'source' URL).",

      // Pydantic output — CrewAI coerces the LLM response into this model.
      // The researcher returns BureaucracyThinking when questions are needed,
      // or a BureaucracyReport-shaped response when research is complete.
      "output_pydantic": { "python": "guide_creator_flow.crews.content_crew.output_models.BureaucracyThinking" },

      // Which agent handles this task
      "agent": "Search_info"
    },
    {
      // Task identifier
      "name": "collect_the_result_returned_task",

      // What the task should accomplish.
      // Receives the previous task's Pydantic output in context.
      // PATH A — questions present: clean up and return BureaucracyThinking.
      // PATH B — research present: build and return the final BureaucracyReport.
      "description": "Look at the output of the previous task in your context and decide which path to take.\n\nPATH A — If the previous task returned a BureaucracyThinking object (i.e. it has a non-empty 'questions' list): the researcher could not proceed because personal information was missing. You must NOT write a report. Return a BureaucracyThinking object with the same questions, cleaned up: remove duplicates, merge similar ones, rewrite each in clear and simple English, and keep at most 3. Each question must have a 'text' (the question itself) and a 'why' (why the answer matters). Do not add new questions.\n\nPATH B — If the previous task has research content (arrival steps, transport info, other info): write the final structured report. Turn the research into a BureaucracyReport object with three lists:\n- 'arrival_checklist': the official arrival 'must-do' steps for {destination_city}, {destination_country}.\n- 'transport_card_steps': documents and steps required for a public transport card in {destination_city}.\n- 'other_info': other useful information for incoming Erasmus+ students.\nEach item must have 'title' (short action title), 'description' (1–3 sentences), and 'source' (official URL or empty string).\nUse ONLY the information from the previous task and from {extra_inputs}. Do NOT invent facts. Mark items with no official source with source = ''.\nWrite everything in English.",

      "expected_output": "PATH A (questions needed): a BureaucracyThinking object with a 'questions' list of at most 3 cleaned-up questions, each with 'text' and 'why'. PATH B (research ready): a BureaucracyReport object with 'arrival_checklist', 'transport_card_steps', and 'other_info' lists (each ChecklistItem has 'title', 'description', 'source').",

      // Final task returns BureaucracyReport when research is complete,
      // or BureaucracyThinking (with questions) when more info is needed.
      "output_pydantic": { "python": "guide_creator_flow.crews.content_crew.output_models.BureaucracyReport" },

      // Which agent handles this task
      "agent": "Create_report"
    }
  ],

  // Execution process: tasks run in order, each receiving prior task outputs
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Optional runtime input defaults.
  "inputs": {}
}
