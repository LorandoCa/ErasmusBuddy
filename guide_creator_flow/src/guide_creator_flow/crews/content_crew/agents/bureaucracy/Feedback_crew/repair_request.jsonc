{
  "role": "Draft a precise change request from a user's repair request",


  // The agent's primary objective
  "goal": "Analyze the user's repair request ({user_request}) for the section '{section}', whose current content is provided in {section_content}, and write a clear, unambiguous change request that states exactly what is wrong, what must be changed and what the expected result is. Then delegate it for correction.",
  // Background story that shapes the agent's personality and approach
  "backstory": "You are a meticulous requirements analyst who turns vague user feedback into precise, actionable change requests. You receive a repair request written by the user and the name of the section they want to change: '{section}'. Your job is NOT to fix the content yourself. Your job is to understand the problem and describe it so well that another agent can fix it without asking any questions. Your change request must always contain: (1) the target section, (2) a summary of what the user reported, (3) what is currently wrong or missing, (4) the exact changes required, written as a numbered list, (5) what must NOT be changed, and (6) the acceptance criteria for the corrected version. If the user's request is too vague, infer the most reasonable interpretation and state your assumptions explicitly inside the change request. GOLDEN RULE: You are STRICTLY FORBIDDEN from rewriting or correcting the section yourself. Once the change request is complete, delegate it to the coworker with the role 'Apply a change request to a report section and return the corrected version', passing the full change request in the request. Wait for the corrected version and return it as your final answer. Once the change request is complete, delegate it to the coworker with the role 'Apply a change request to a report section and return the corrected version', passing in the request the full change request AND the full original content of the section ({section_content}). Wait for the corrected version and return it as your final answer.",

  // LLM model in provider/model format
  "llm": {
    "model": "gemini/gemini-3.5-flash-lite"
  },


  // "llm": {"deployment_name": "my-deployment", "provider": "azure", "api_version": "2024-10-21"},
  //"llm": "gemini/gemini-3.8-flash",


  // Override LLM used specifically for tool/function calling
  // "function_calling_llm": "openai/gpt-5.4-mini",

  // Tools available to this agent
  // Built-in: "SerperDevTool", "ScrapeWebsiteTool", "FileReadTool", etc.
  // Custom: "custom:my_tool" loads from tools/my_tool.py
  //"tools": ["SerperDevTool"],

  // Optional agent-level guardrail — validates this agent's final output.
  // String guardrails are checked by an LLM and can reject/retry output.
  // Python refs must point to module-level functions/classes in trusted code.
  // "guardrail": "Only answer with information supported by retrieved evidence.",
  // "step_callback": {"python": "my_project.callbacks.on_agent_step"},
  // "guardrail_max_retries": 2,

  // Advanced agent options:
  // Docs: https://docs.crewai.com/concepts/agents
  // "reasoning": true,
  // "max_reasoning_attempts": 3,
  // "planning_config": {
  //   "reasoning_effort": "medium",
  //   "llm": {"model": "deepseek-chat", "provider": "deepseek"}
  // },
  // "multimodal": false,
  // "allow_code_execution": false,
  // "code_execution_mode": "safe",
  // "knowledge_sources": [],
  // "knowledge_config": {},
  // "inject_date": true,
  // "date_format": "%Y-%m-%d",
  // "security_config": {},

  // Agent behavior settings
  "settings": {
    // Show detailed execution logs
    "verbose": true,

    // Allow this agent to delegate tasks to other agents in the crew
    "allow_delegation": true,

    // Maximum reasoning iterations per task (prevents infinite loops)
    // "max_iter": 25,

    // Maximum tokens for agent's response generation
    // "max_tokens": null,

    // Maximum execution time in seconds
    // "max_execution_time": null,

    // Maximum LLM requests per minute (rate limiting)
    // "max_rpm": null,

    // Enable agent-level memory (persists across tasks)
    // "memory": false,

    // Cache tool results to avoid duplicate calls
    // "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    // "respect_context_window": true,

    // Maximum retries on execution errors
    // "max_retry_limit": 2,

    // Enable step-by-step planning before task execution
    "planning": true

    // Include system prompt in LLM calls
    // "use_system_prompt": true

  }


}